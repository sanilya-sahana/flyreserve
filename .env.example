# FlyReserve — environment variables example
# Copy this file to .env and fill in real values before running locally.
# NEVER commit a populated .env file.

# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────
PORT=4000

# ──────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL 14+)
# Required for production and staging. Not required for unit tests (mock provider).
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://flyreserve:changeme@localhost:5432/flyreserve

# ──────────────────────────────────────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────────────────────────────────────
# Set to "true" in local development ONLY to skip bearer-token checks.
# Must be absent or "false" in staging and production.
AUTH_BYPASS=true

# Secret for internal service-to-service endpoints (webhooks, etc).
# Required in all non-bypass environments.
INTERNAL_API_SECRET=changeme-internal-secret

# ──────────────────────────────────────────────────────────────────────────────
# Payment providers (open items — see SAH-16 and SAH-58)
# ──────────────────────────────────────────────────────────────────────────────
# Stripe (primary payment provider)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_WEBHOOK_ID=...

# ──────────────────────────────────────────────────────────────────────────────
# Flight data provider (open item — see SAH-16)
# The mock provider (MockFlightProvider) is used by default in development.
# ──────────────────────────────────────────────────────────────────────────────
# FLIGHT_PROVIDER=mock
# FLIGHT_PROVIDER_API_KEY=...
# FLIGHT_PROVIDER_BASE_URL=...

# ──────────────────────────────────────────────────────────────────────────────
# Frontend (apps/web — Vite)
# These are injected at build time via Vite's VITE_ prefix convention.
# ──────────────────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:4000
